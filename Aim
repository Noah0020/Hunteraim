-- HELPERS
local function getRoot(m)
	return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function folderKids(name)
	local f = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild(name)
	if not f then return {} end
	local t = {}
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function getKillers() return folderKids("Killers") end
local function getSurvivors() return folderKids("Survivors") end


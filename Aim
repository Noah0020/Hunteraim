local function loadRayfield(url, label)
	local ok, result = pcall(function()
		local source = game:HttpGet(url)
		if not source or #source == 0 then error(label .. " returned empty source") end
		local fn = loadstring(source)
		if not fn then error(label .. " loadstring failed") end
		return fn()
	end)
	if ok and result then return result end
	warn("[Huntsaken] " .. label .. " ERROR:", result)
	return nil
end


local ITEM_KEYWORDS = {
	"trap", "beartrap", "bear trap", "medkit", "med kit", "bloxy", "cola",
	"pizza", "slice", "bandage", "healthkit", "health kit", "pumpkin",
	"candy", "battery", "crowbar", "toolbox", "nail", "wire", "fuse",
	"puzzle", "generator", "gen", "radio", "phone", "key", "gear",
	"flashlight", "torch", "candle", "umbrella", "rope", "duct tape",
	"scrap", "metal", "wood", "plate", "wirecutters", "wrench",
}

local function nameMatchesItem(name, filter)
	if not name then return false end
	local n = name:lower()
	if filter then
		if n:find(filter, 1, true) then return true end
	else
		for _, kw in ipairs(ITEM_KEYWORDS) do
			if n:find(kw, 1, true) then return true end
		end
	end
	return false
end

local function isItemModel(inst)
	if not inst or not inst.Parent then return false end
	if not (inst:IsA("Model") or inst:IsA("Tool") or inst:IsA("BasePart")) then return false end
	local playersFolder = Workspace:FindFirstChild("Players")
	if playersFolder and inst:IsDescendantOf(playersFolder) then return false end
	local n = inst.Name:lower()
	if n == "baseplate" or n == "camera" or n == "terrain" then return false end
	return true
end

local function getItemPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") or inst:IsA("Tool") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

-- ESP
local highlights = {}
local billboards = {}
local boxDrawings = {}
local chams = {}
local itemHighlights = {}
local itemNames = {}

local function createDrawing(class, props)
	if not Drawing then return nil end
	local ok, d = pcall(function() return Drawing.new(class) end)
	if not ok or not d then return nil end
	for k, v in pairs(props or {}) do pcall(function() d[k] = v end) end
	return d
end

local function clearDrawing(d)
	if d then pcall(function() d:Remove() end) end
end

local function clearHL(m)
	if highlights[m] then pcall(function() highlights[m]:Destroy() end) highlights[m] = nil end
	if billboards[m] then
		for _, bb in pairs(billboards[m]) do pcall(function() bb:Destroy() end) end
		billboards[m] = nil
	end
	if boxDrawings[m] then
		for _, d in pairs(boxDrawings[m]) do clearDrawing(d) end
		boxDrawings[m] = nil
	end
	if chams[m] then
		for _, p in pairs(chams[m]) do pcall(function() p:Destroy() end) end
		chams[m] = nil
	end
end

local function applyHL(model, color)
	if not model or not model.Parent then return end
	local h = highlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "HS_HL"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillTransparency = 0.65
		h.OutlineTransparency = 0
		h.Parent = model
		highlights[model] = h
	end
	h.FillColor, h.OutlineColor, h.Adornee = color, color, model
end

local function removeHLOnly(model)
	if highlights[model] then pcall(function() highlights[model]:Destroy() end) highlights[model] = nil end
end

local function applyNameTag(model, color, showDist)
	if not model or not model.Parent then return end
	local hrp = getRoot(model)
	if not hrp then return end
	local bb = billboards[model]
	if not bb then
		local gui = Instance.new("BillboardGui")
		gui.Name = "HS_Name"
		gui.Size = UDim2.fromOffset(200, 40)
		gui.StudsOffset = Vector3.new(0, 3, 0)
		gui.AlwaysOnTop = true
		gui.Adornee = hrp
		gui.Parent = hrp

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.fromScale(1, 1)
		txt.BackgroundTransparency = 1
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 14
		txt.TextStrokeTransparency = 0
		txt.TextStrokeColor3 = Color3.new(0, 0, 0)
		txt.TextColor3 = color
		txt.Parent = gui

		billboards[model] = { gui = gui, txt = txt }
	else
		if bb.txt then bb.txt.TextColor3 = color end
	end
	local entry = billboards[model]
	if entry and entry.txt then
		local base = model.Name
		if showDist then
			local myRoot = getRoot(LocalPlayer.Character)
			if myRoot then
				local dist = math.floor((hrp.Position - myRoot.Position).Magnitude)
				entry.txt.Text = string.format("%s [%dm]", base, dist)
			else
				entry.txt.Text = base
			end
		else
			entry.txt.Text = base
		end
	end
end

local function applyBox(model, color)
	pcall(function()
		local hrp = getRoot(model)
		if not hrp then return end
		local d = boxDrawings[model]
		if not d then
			d = {
				box = createDrawing("Square", { Thickness = 1, Filled = false, Color = color, Transparency = 1, Visible = false }),
				tracer = createDrawing("Line", { Thickness = 1, Color = color, Transparency = 1, Visible = false }),
			}
			boxDrawings[model] = d
		end
		if d.box then d.box.Color = color end
		if d.tracer then d.tracer.Color = color end
	end)
end

local function applyChams(model, color)
	if not model or not model.Parent then return end
	local hrp = getRoot(model)
	if not hrp then return end
	if not chams[model] then chams[model] = {} end
	local c = chams[model]
	if c[hrp] and c[hrp].Parent then
		c[hrp].Color = color
		return
	end
	local part = Instance.new("Part")
	part.Name = "HS_Chams"
	part.Size = hrp.Size
	part.CFrame = hrp.CFrame
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Material = Enum.Material.ForceField
	part.Color = color
	part.Transparency = 0.55
	part.Parent = Workspace
	c[hrp] = part
end

local function updateChams()
	for model, list in pairs(chams) do
		if not model.Parent then
			for _, p in pairs(list) do pcall(function() p:Destroy() end) end
			chams[model] = nil
		else
			local hrp = getRoot(model)
			for part, inst in pairs(list) do
				if part ~= hrp or not part.Parent then
					pcall(function() inst:Destroy() end)
					list[part] = nil
				else
					inst.CFrame = hrp.CFrame
					inst.Size = hrp.Size
				end
			end
		end
	end
end

local function shouldSkip(model)
	if model == LocalPlayer.Character then return true end
	if not S.TeamCheck then return false end
	local myChar = LocalPlayer.Character
	if not myChar then return false end
	local myFolder = myChar.Parent and myChar.Parent.Name
	if not myFolder then return false end
	local theirFolder = model.Parent and model.Parent.Name
	return myFolder == theirFolder
end

local function renderEspForModel(model, color, opts)
	if shouldSkip(model) then clearHL(model) return end
	local hrp = getRoot(model)
	local myRoot = getRoot(LocalPlayer.Character)
	if not hrp or not myRoot then return end
	local dist = (hrp.Position - myRoot.Position).Magnitude
	if S.MaxEspDist > 0 and dist > S.MaxEspDist then
		clearHL(model)
		return
	end
	if opts.hl then applyHL(model, color) else removeHLOnly(model) end
	if opts.name then applyNameTag(model, S.NameColor, opts.dist) end
	if opts.box or opts.tracer then applyBox(model, opts.box and S.BoxColor or color) end
	if opts.chams then applyChams(model, color) end
end

local function updateBillboardDist()
	for model, bb in pairs(billboards) do
		if not model.Parent then
			for _, e in pairs(bb) do pcall(function() e:Destroy() end) end
			billboards[model] = nil
		else
			local parentName = model.Parent and model.Parent.Name
			local showK = S.KillerName and parentName == "Killers"
			local showS = S.SurvivorName and parentName == "Survivors"
			local showDist = (S.KillerDist and parentName == "Killers") or (S.SurvivorDist and parentName == "Survivors")
			if not (showK or showS) then
				if bb.gui then pcall(function() bb.gui:Destroy() end) end
				billboards[model] = nil
			else
				applyNameTag(model, S.NameColor, showDist)
			end
		end
	end
end

local function updateBoxesAndTracers()
	for model, d in pairs(boxDrawings) do
		if not model.Parent or not getRoot(model) then
			for _, x in pairs(d) do clearDrawing(x) end
			boxDrawings[model] = nil
		else
			local hrp = getRoot(model)
			local myRoot = getRoot(LocalPlayer.Character)
			local parentName = model.Parent and model.Parent.Name
			local showBox = (S.KillerBox and parentName == "Killers") or (S.SurvivorBox and parentName == "Survivors")
			local showTracer = (S.KillerTracer and parentName == "Killers") or (S.SurvivorTracer and parentName == "Survivors")
			local skip = shouldSkip(model)
			local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
			local tooFar = S.MaxEspDist > 0 and dist > S.MaxEspDist

			if d.box then
				if showBox and not skip and not tooFar then
					local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						local topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
						local botPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
						local height = math.abs(topPos.Y - botPos.Y)
						local width = height / 2
						d.box.Size = Vector2.new(width, height)
						d.box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
						d.box.Visible = true
						d.box.Color = (parentName == "Killers") and S.KillerColor or S.SurvivorColor
					else
						d.box.Visible = false
					end
				else
					d.box.Visible = false
				end
			end

			if d.tracer then
				if showTracer and not skip and not tooFar then
					local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
						d.tracer.To = Vector2.new(pos.X, pos.Y)
						d.tracer.Visible = true
						d.tracer.Color = (parentName == "Killers") and S.KillerColor or S.SurvivorColor
					else
						d.tracer.Visible = false
					end
				else
					d.tracer.Visible = false
				end
			end
		end
	end
end

local function refreshEsp()
	for m in pairs(highlights) do if not m.Parent then clearHL(m) end end

	for _, k in ipairs(getKillers()) do
		renderEspForModel(k, S.KillerColor, {
			hl = S.KillerEsp, name = S.KillerName, box = S.KillerBox,
			tracer = S.KillerTracer, chams = S.KillerChams, dist = S.KillerDist,
		})
		if not S.KillerEsp then removeHLOnly(k) end
	end
	for _, s in ipairs(getSurvivors()) do
		renderEspForModel(s, S.SurvivorColor, {
			hl = S.SurvivorEsp, name = S.SurvivorName, box = S.SurvivorBox,
			tracer = S.SurvivorTracer, chams = S.SurvivorChams, dist = S.SurvivorDist,
		})
		if not S.SurvivorEsp then removeHLOnly(s) end
	end

	updateBillboardDist()
	updateBoxesAndTracers()
	updateChams()
end


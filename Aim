local S = {
    NormalAim = false,
    AimMode = "Camera",
    Prediction = 0.15,
    Smooth = 0.35,

    SilentAim = false,

    Learning = false,
    ForceLearn = false,
    Learned = {},

    MatchActive = false,
    PlayingSurvivor = false,
}

local FILE_NAME = "hunteraim_v6.json"
local canSave = (type(writefile) == "function" and type(readfile) == "function")

local function loadStore()
    if not canSave then return end
    pcall(function()
        if isfile and isfile(FILE_NAME) then
            local data = readfile(FILE_NAME)
            if data and #data > 0 then
                local decoded = HttpService:JSONDecode(data)
                if type(decoded) == "table" then
                    S.Learned = decoded
                end
            end
        end
    end)
end

local function saveStore()
    if not canSave then return end
    pcall(function()
        writefile(FILE_NAME, HttpService:JSONEncode(S.Learned))
    end)
end

local function deleteLearned(charKey, animId)
    if not S.Learned[charKey] then return end
    S.Learned[charKey][animId] = nil
    if next(S.Learned[charKey]) == nil then
        S.Learned[charKey] = nil
    end
    saveStore()
end

local function clearCharacter(charKey)
    if not S.Learned[charKey] then return end
    S.Learned[charKey] = nil
    saveStore()
end

loadStore()


-- HELPERS
-- ============================================================
local function getRoot(m)
    return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function getMyCharacter()
    local c = LocalPlayer.Character
    if not c then return nil, nil end
    return c:GetAttribute("CharacterName") or c.Name,
           c:GetAttribute("SkinName") or "Default"
end

local function getMyRole()
    local c = LocalPlayer.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end

local function getTargetFolder()
    local players = Workspace:FindFirstChild("Players")
    if not players then return nil end
    local role = getMyRole()
    if role == "Survivors" then return players:FindFirstChild("Killers") end
    if role == "Killers" then return players:FindFirstChild("Survivors") end
    return nil
end

local function getCharKey()
    local name, skin = getMyCharacter()
    if not name then return nil end
    return name .. ":" .. (skin or "Default")
end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "HunterAim",
            Text = text or "",
            Duration = duration or 4,
        })
    end)
end

-- ============================================================
-- CHECK A — match scan
-- ============================================================
local function runMatchScan()
    local myRoot = getRoot(LocalPlayer.Character)
    local scanCenter = myRoot and myRoot.Position or Vector3.new(0, 50, 0)
    local size = Vector3.new(1000, 2000, 1000)
    local cf = CFrame.new(scanCenter)

    local parts
    local ok = pcall(function()
        parts = Workspace:GetPartBoundsInBox(cf, size)
    end)
    if not ok or not parts then return false end

    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model.Parent and model.Parent.Name == "Killers" then
            return true
        end
    end
    return false
end

-- ============================================================
-- CHECK B — survivor anim watch
-- ============================================================
local lastSurvivorAnimTime = 0

local function attachAnimWatcher(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:WaitForChild("Animator", 5)
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        local p = track.Priority
        if p == Enum.AnimationPriority.Movement
           or p == Enum.AnimationPriority.Idle
           or p == Enum.AnimationPriority.Core then
            lastSurvivorAnimTime = os.clock()
        end
    end)
end

if LocalPlayer.Character then task.spawn(attachAnimWatcher, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c) task.spawn(attachAnimWatcher, c) end)

local function isPlayingSurvivor()
    local role = getMyRole()
    if role ~= "Survivors" then return false end
    return (os.clock() - lastSurvivorAnimTime) < 3
end


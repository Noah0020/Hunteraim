-- ============================================================
-- CACHED TARGET
-- ============================================================
local cachedTargetHRP = nil

local function updateCachedTarget()
    local myRoot = getRoot(LocalPlayer.Character)
    if not myRoot then cachedTargetHRP = nil return end
    local folder = getTargetFolder()
    if not folder then cachedTargetHRP = nil return end
    local bestHRP, bestD = nil, 500
    for _, s in ipairs(folder:GetChildren()) do
        if s:IsA("Model") and s ~= LocalPlayer.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; bestHRP = hrp end
            end
        end
    end
    cachedTargetHRP = bestHRP
end

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(updateCachedTarget)
    end
end)

-- ============================================================
-- LEARNING
-- ============================================================
local IGNORE_IDS = {}

-- Hard blacklist: any anim whose NAME contains one of these is never learned
local IGNORE_NAME_KEYWORDS = {
    -- cosmetics / emotes
    "chicken", "emote", "taunt", "dance", "wave", "sit", "pose",
    "victory", "defeat", "intro", "outro", "laugh", "cry", "cheer",
    "clap", "point", "salute", "flip", "spin", "idle",
    -- items / utility
    "coin", "heal", "eat", "drink", "use", "consume", "bandage",
    "medkit", "potion", "item", "pickup", "drop", "throw", "carry",
    "open", "close", "interact", "revive", "rescue", "unlock",
    -- movement
    "walk", "run", "sprint", "jump", "fall", "land", "crouch",
    "slide", "vault", "climb", "swim", "dodge",
    -- misc
    "spawn", "death", "hurt",
}

-- Whitelist keywords: if the anim name contains one of these AND no blacklist match,
-- we're much more confident it's an actual attack.
local ATTACK_NAME_KEYWORDS = {
    "attack", "slash", "swing", "strike", "punch", "kick",
    "stab", "shoot", "fire", "cast", "ability", "skill",
    "sword", "blade", "weapon", "melee", "lunge", "combo",
    "special", "power", "smash", "swipe", "chop", "hit",
    "stun", "bash", "smack", "whack",
}

local abilityActive = false
local abilityId = nil
local abilityStartedAt = 0
local firstLearnNotified = false

local function isAbilityCandidate(track)
    if not track or not track.Animation then return false end

    local id = tostring(track.Animation.AnimationId):match("%d+")
    if not id then return false end
    if IGNORE_IDS[id] then return false end

    -- length filter
    if track.Length < 0.15 or track.Length > 3.5 then return false end

    -- priority filter
    local p = track.Priority
    if p == Enum.AnimationPriority.Idle
       or p == Enum.AnimationPriority.Movement
       or p == Enum.AnimationPriority.Core then
        return false
    end

    -- name filters
    local animName = track.Animation.Name
    local lower = animName and string.lower(animName) or ""

    if #lower > 0 then
        -- hard blacklist
        for _, kw in ipairs(IGNORE_NAME_KEYWORDS) do
            if string.find(lower, kw, 1, true) then
                return false
            end
        end
        -- attack whitelist (immediate accept)
        for _, kw in ipairs(ATTACK_NAME_KEYWORDS) do
            if string.find(lower, kw, 1, true) then
                return true, id
            end
        end
    end

    -- Behavioral fallback: require Action priority + non-looping
    if p ~= Enum.AnimationPriority.Action
       and p ~= Enum.AnimationPriority.Action2
       and p ~= Enum.AnimationPriority.Action3
       and p ~= Enum.AnimationPriority.Action4 then
        return false
    end

    if track.Looped then return false end

    -- Reject slow anims played from a standstill
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        local moving = hum.MoveDirection.Magnitude > 0.1
                        or hrp.AssemblyLinearVelocity.Magnitude > 2
        if not moving and track.Length > 0.6 then
            return false
        end
    end

    return true, id
end

local function attachLearner(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:WaitForChild("Animator", 5)
    if not anim then return end

    anim.AnimationPlayed:Connect(function(track)
        if not S.Learning then return end
        if not S.MatchActive then return end
        if not S.ForceLearn and not isPlayingSurvivor() then return end

        local ok, id = isAbilityCandidate(track)
        if not ok then return end

        local charKey = getCharKey()
        if not charKey then return end

        task.wait()
        if track.Length > 0 then
            abilityActive = true
            abilityId = id
            abilityStartedAt = os.clock()

            if not S.Learned[charKey] then S.Learned[charKey] = {} end
            if not S.Learned[charKey][id] then
                S.Learned[charKey][id] = true
                saveStore()

                if not firstLearnNotified then
                    firstLearnNotified = true
                    notify("✓ Aim Ready", "Learned " .. charKey .. " — aim now active", 5)
                else
                    notify("✓ Learned", charKey .. " | " .. (track.Animation.Name or id), 3)
                end
                print("[HunterAim] Learned: " .. charKey .. " → " .. id)
            end

            track.Stopped:Once(function()
                if abilityId == id then
                    abilityActive = false
                    abilityId = nil
                end
            end)
            task.delay(math.max(track.Length + 0.5, 2), function()
                if abilityId == id and os.clock() - abilityStartedAt >= track.Length then
                    abilityActive = false
                    abilityId = nil
                end
            end)
        end
    end)
end

if LocalPlayer.Character then task.spawn(attachLearner, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c) task.spawn(attachLearner, c) end)

local function hasLearnedAnims()
    local charKey = getCharKey()
    if not charKey then return false end
    local tbl = S.Learned[charKey]
    if not tbl then return false end
    for _ in pairs(tbl) do return true end
    return false
end

-- ============================================================
-- AIM
-- ============================================================
local function predictHRP(hrp, seconds)
    if not hrp then return nil end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    return hrp.Position + vel * seconds
end

local function applyAim(targetPos, mode, smooth)
    if not targetPos then return end
    smooth = smooth or S.Smooth
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(
            CFrame.lookAt(Camera.CFrame.Position, targetPos),
            smooth
        )
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
            if (flat - myRoot.Position).Magnitude > 0.1 then
                myRoot.CFrame = myRoot.CFrame:Lerp(
                    CFrame.lookAt(myRoot.Position, flat),
                    smooth
                )
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not S.NormalAim then return end
    if not S.MatchActive then return end
    if not S.ForceLearn and not isPlayingSurvivor() then return end
    if not hasLearnedAnims() then return end
    if not abilityActive then return end
    if not cachedTargetHRP or not cachedTargetHRP.Parent then return end
    local targetPos = predictHRP(cachedTargetHRP, S.Prediction)
    applyAim(targetPos, S.AimMode)
end)


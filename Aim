    -- Prediction
    PredictMode     = "Both",         -- "Off" | "Ping" | "Velocity" | "Both"
    PredictLead     = 0.15,           -- velocity lead (seconds)
    PingMultiplier  = 1.0,            -- scales ping half-life
}

-- ============================================================
-- WHITELIST  (ONLY these three abilities will trigger aim)
-- ============================================================
local ABILITY_ANIM_KEYS = {
    -- Shedletsky
    Slash       = true,

    -- Chance — "Shoot" ability spans these 4 anims
    AimGun      = true,
    GunFire     = true,
    GunExplode  = true,
    GunFail     = true,

    -- Two Time — "Dagger" ability spans Stab + Lunge
    Stab        = true,
    LungeStart  = true,
    Lunge       = true,
}

local ABILITY_SOUND_KEYS = {
    -- Shedletsky
    Slash       = true,

    -- Chance
    GunFire     = true,
    GunExplode  = true,
    GunFail     = true,
    Shoot       = true,

    -- Two Time
    Stab        = true,
    Lunge       = true,
}

-- Abilities that use ping-based prediction (ranged / projectile)
local PING_ABILITIES = {
    AimGun     = true,
    GunFire    = true,
    GunExplode = true,
    GunFail    = true,
}


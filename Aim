local function itemFilterPass(inst)
	if not isItemModel(inst) then return false end
	local n = inst.Name
	if S.TrapEsp and nameMatchesItem(n, "trap") then return true end
	if S.MedkitEsp and (nameMatchesItem(n, "medkit") or nameMatchesItem(n, "med kit") or nameMatchesItem(n, "bandage") or nameMatchesItem(n, "health")) then return true end
	if S.BloxyEsp and (nameMatchesItem(n, "bloxy") or nameMatchesItem(n, "cola")) then return true end
	if S.GenEsp and (nameMatchesItem(n, "generator") or nameMatchesItem(n, "gen") or nameMatchesItem(n, "puzzle")) then return true end
	if S.PizzaEsp and (nameMatchesItem(n, "pizza") or nameMatchesItem(n, "slice")) then return true end
	return false
end

local function refreshItemEsp()
	for inst in pairs(itemHighlights) do
		if not inst.Parent then clearItemHL(inst) end
	end
	for inst in pairs(itemNames) do
		if not inst.Parent then clearItemHL(inst) end
	end

	local anyOn = S.TrapEsp or S.MedkitEsp or S.BloxyEsp or S.GenEsp or S.PizzaEsp
	if not anyOn then
		for inst in pairs(itemHighlights) do clearItemHL(inst) end
		return
	end

	for _, d in ipairs(Workspace:GetDescendants()) do
		if itemFilterPass(d) then
			applyItemHL(d, S.ItemColor)
			applyItemName(d, S.ItemColor)
		end
	end
end

task.spawn(function()

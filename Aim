-- HELPERS
-- ============================================================
local function getRoot(m)
    return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function getMyRole()
    local c = LocalPlayer.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end

local function getTargetFolder()
    local players = Workspace:FindFirstChild("Players")
    if not players then return nil end
    return players:FindFirstChild("Killers")   -- survivor script → aim at killers
end

local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "HunterAim", Text = text or "", Duration = dur or 4,
        })
    end)
end

local function getPing()
    local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    if ok and type(v) == "number" then return v end
    return 0
end

-- ============================================================
-- ASSET READING
-- ============================================================
local Assets = ReplicatedStorage:FindFirstChild("Assets")
    or ReplicatedStorage:WaitForChild("Assets", 10)

local myAbilityAnimIds  = {}   -- [animId] = abilityName
local myAbilitySoundIds = {}   -- [soundId] = abilityName

local function pushIdsFromValue(value, intoSet, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id and not intoSet[id] then intoSet[id] = abilityName end
    elseif type(value) == "table" then
        for _, v in pairs(value) do
            pushIdsFromValue(v, intoSet, abilityName)
        end
    end
end

-- Read every sound table name we've seen in Forsaken configs.
local SOUND_FIELDS = {
    "Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds",
}

local function readConfigAnimations(module, charName, skinName)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end

    if type(cfg.Animations) == "table" then
        for key, value in pairs(cfg.Animations) do
            if ABILITY_ANIM_KEYS[key] then
                pushIdsFromValue(value, myAbilityAnimIds, key)
            end
        end
    end

    for _, field in ipairs(SOUND_FIELDS) do
        local soundTable = cfg[field]
        if type(soundTable) == "table" then
            for key, value in pairs(soundTable) do
                if ABILITY_SOUND_KEYS[key] then
                    pushIdsFromValue(value, myAbilitySoundIds, key)
                end
            end
        end
    end

    print(string.format("[HunterAim] Loaded config: %s:%s", tostring(charName), tostring(skinName)))
end

local function loadMyAbilityIds(char)
    myAbilityAnimIds  = {}
    myAbilitySoundIds = {}

    if not Assets then
        warn("[HunterAim] ReplicatedStorage.Assets not found")
        return
    end

    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"

    -- 1) Base: Assets.Survivors.<Name>.Config
    local survivorsFolder = Assets:FindFirstChild("Survivors")
    local survivorFolder  = survivorsFolder and survivorsFolder:FindFirstChild(charName)
    if survivorFolder then
        local baseCfg = survivorFolder:FindFirstChild("Config")
        if baseCfg then
            readConfigAnimations(baseCfg, charName, "Default")
        end
    end

    -- 2) Skin: Assets.Skins.Survivors.<Name>.<Skin>.Config
    if skinName and skinName ~= "Default" then
        local skinsRoot  = Assets:FindFirstChild("Skins")
        local skinsSurv  = skinsRoot and skinsRoot:FindFirstChild("Survivors")
        local skinChar   = skinsSurv and skinsSurv:FindFirstChild(charName)
        local skinFolder = skinChar and skinChar:FindFirstChild(skinName)
        if skinFolder then
            local skinCfg = skinFolder:FindFirstChild("Config")
            if skinCfg then
                readConfigAnimations(skinCfg, charName, skinName)
            end
        end
    end

    local nA, nS = 0, 0
    for _ in pairs(myAbilityAnimIds)  do nA += 1 end
    for _ in pairs(myAbilitySoundIds) do nS += 1 end
    print(string.format("[HunterAim] %s:%s → %d anim id(s), %d sound id(s)",
        charName, skinName, nA, nS))
end

-- ============================================================
-- EVENT GATE
-- ============================================================
local eventActive    = false
local eventRefCount  = 0
local currentAbility = nil

local function pushEvent(kind, id, name)
    eventRefCount += 1
    eventActive = true
    currentAbility = name
    if S.Debug then
        print(string.format("[HA EVENT START (%d)] [%s] id=%s name=%s",
            eventRefCount, kind, tostring(id), tostring(name or "")))
    end
end

local function popEvent(kind, id)
    eventRefCount = math.max(0, eventRefCount - 1)
    if eventRefCount == 0 then
        eventActive = false
        currentAbility = nil
        if S.Debug then
            print(string.format("[HA EVENT END] [%s] id=%s", kind, tostring(id)))
        end
    end
end

local function isPingAbility(abilityName)
    return abilityName and PING_ABILITIES[abilityName] == true
end

-- ---------- layer 1: animator on MY character ----------
local myAnimConn   = nil
local mySoundConns = {}

local function attachAnimWatcher(char)
    if myAnimConn then
        pcall(function() myAnimConn:Disconnect() end)
        myAnimConn = nil
    end

    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)
    if not animator then return end

    myAnimConn = animator.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if not anim then return end
        local animId = tostring(anim.AnimationId):match("%d+")
        if not animId then return end

        if S.Debug then
            print("[HA MY ANIM]", animId, myAbilityAnimIds[animId] or anim.Name or "")
        end

        local abilityName = myAbilityAnimIds[animId]
        if not abilityName then return end

        pushEvent("anim", animId, abilityName)

        local ended = false
        local function finish()
            if ended then return end
            ended = true
            popEvent("anim", animId)
        end
        track.Stopped:Once(finish)
        local dur = track.Length
        if not dur or dur <= 0 then dur = 0.5 end
        task.delay(dur + 0.2, finish)
    end)
end

-- ---------- layer 2: sounds on MY character ----------
local function soundIdOf(sound)
    if not sound or not sound.SoundId then return nil end
    return tostring(sound.SoundId):match("%d+")
end

local function hookMySound(s)
    if not s:IsA("Sound") then return end
    return s.Playing:Connect(function()
        local sid = soundIdOf(s)
        if not sid then return end

        if S.Debug then
            print("[HA MY SOUND]", sid, myAbilitySoundIds[sid] or s.Name or "")
        end

        local abilityName = myAbilitySoundIds[sid]
        if not abilityName then return end

        pushEvent("sound", sid, abilityName)
        local dur = s.TimeLength
        if not dur or dur <= 0 then dur = 0.4 end
        task.delay(dur + 0.15, function()
            popEvent("sound", sid)
        end)
    end)
end

local function attachSoundWatcher(char)
    for _, c in ipairs(mySoundConns) do
        pcall(function() c:Disconnect() end)
    end
    mySoundConns = {}

    for _, s in ipairs(char:GetDescendants()) do
        if s:IsA("Sound") then
            local c = hookMySound(s)
            if c then table.insert(mySoundConns, c) end
        end
    end
    table.insert(mySoundConns, char.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then
            local c = hookMySound(d)
            if c then table.insert(mySoundConns, c) end
        end
    end))
end

-- ============================================================
-- MATCH DETECTION
-- ============================================================
local lastSurvivorAnimTime = 0

local function attachAnimActivity(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:WaitForChild("Animator", 5)
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        local p = track.Priority
        if p == Enum.AnimationPriority.Movement
           or p == Enum.AnimationPriority.Idle
           or p == Enum.AnimationPriority.Core then
            lastSurvivorAnimTime = os.clock()
        end
    end)
end

local function runMatchScan()
    local myRoot = getRoot(LocalPlayer.Character)
    local center = myRoot and myRoot.Position or Vector3.new(0, 50, 0)
    local parts
    local ok = pcall(function()
        parts = Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(1000, 2000, 1000))
    end)
    if not ok or not parts then return false end
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model.Parent and model.Parent.Name == "Killers" then
            return true
        end
    end
    return false
end

local function isPlayingSurvivor()
    if getMyRole() ~= "Survivors" then return false end
    return (os.clock() - lastSurvivorAnimTime) < 3
end

-- ============================================================
-- CHARACTER ATTACH
-- ============================================================
local function attachToCharacter(char)
    if char ~= LocalPlayer.Character then return end

    local t0 = os.clock()
    while not (char:GetAttribute("CharacterName")) and os.clock() - t0 < 3 do
        task.wait(0.1)
    end

    loadMyAbilityIds(char)
    task.spawn(attachAnimWatcher, char)
    task.spawn(attachSoundWatcher, char)
    task.spawn(attachAnimActivity, char)

    local n, s = 0, 0
    for _ in pairs(myAbilityAnimIds)  do n += 1 end
    for _ in pairs(myAbilitySoundIds) do s += 1 end
    if n + s > 0 then
        notify("✓ HunterAim Ready",
            string.format("%s — %d anim / %d sound", char.Name, n, s), 4)
    end
end

if LocalPlayer.Character then
    task.spawn(attachToCharacter, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(function(c)
    eventActive    = false
    eventRefCount  = 0
    currentAbility = nil
    task.wait(0.3)
    task.spawn(attachToCharacter, c)
end)

task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            S.MatchActive     = runMatchScan()
            S.PlayingSurvivor = isPlayingSurvivor()
        end)
    end
end)

-- ============================================================
-- CACHED TARGET (nearest killer)
-- ============================================================
local cachedTargetHRP = nil

local function updateCachedTarget()
    local myRoot = getRoot(LocalPlayer.Character)
    if not myRoot then cachedTargetHRP = nil return end
    local folder = getTargetFolder()
    if not folder then cachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(folder:GetChildren()) do
        if s:IsA("Model") and s ~= LocalPlayer.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    cachedTargetHRP = best
end

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(updateCachedTarget)
    end
end)

-- ============================================================
-- PREDICTION
-- ============================================================
local function predictHRP(hrp)
    if not hrp then return nil end
    if S.PredictMode == "Off" then
        return hrp.Position
    end

    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end

    -- Ping only for Chance's gun. Shed + Two Time use velocity only.
    local usePing = isPingAbility(currentAbility)

    local velLead  = 0
    local pingLead = 0

    if S.PredictMode == "Velocity" or S.PredictMode == "Both" then
        velLead = S.PredictLead
    end

    if usePing and (S.PredictMode == "Ping" or S.PredictMode == "Both") then
        local ping = getPing() * 0.5 * S.PingMultiplier
        pingLead = math.clamp(ping, 0, 0.5)
    end

    local totalLead = math.clamp(velLead + pingLead, 0, 0.75)
    return hrp.Position + vel * totalLead
end

local function applyAim(targetPos, mode, smooth)
    if not targetPos then return end
    smooth = smooth or S.Smooth
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(
            CFrame.lookAt(Camera.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local myRoot = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
            if (flat - myRoot.Position).Magnitude > 0.1 then
                myRoot.CFrame = myRoot.CFrame:Lerp(
                    CFrame.lookAt(myRoot.Position, flat), smooth)
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not S.NormalAim then return end
    if not S.MatchActive then return end
    if not isPlayingSurvivor() then return end

    -- THE gate: only aim while one of the whitelisted abilities is playing
    if not eventActive then return end

    if not cachedTargetHRP or not cachedTargetHRP.Parent then return end

    local targetPos = predictHRP(cachedTargetHRP)
    applyAim(targetPos, S.AimMode)
end)


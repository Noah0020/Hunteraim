-- STAMINA
local function applyStamina()
	local ok, sprint = pcall(function()
		return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
	end)
	if not ok or not sprint then return end
	if S.InfStam then
		pcall(function()
			sprint.Stamina = sprint.MaxStamina or S.MaxStam
			if sprint.StaminaLossDisabled ~= nil then sprint.StaminaLossDisabled = true end
		end)
	end
	if S.CustomStam then
		pcall(function()
			sprint.MaxStamina = S.MaxStam
			sprint.StaminaGain = S.StamGain
			if sprint.StaminaLoss then sprint.StaminaLoss = S.StamLoss end
			if sprint.StaminaDrain then sprint.StaminaDrain = S.StamLoss end
			if sprint.SprintSpeed then sprint.SprintSpeed = S.SprintSpeed end
		end)
	end
end

RunService.Heartbeat:Connect(function()
	if S.InfStam or S.CustomStam then pcall(applyStamina) end
end)

-- AUTO GEN
local genConns, genFlag, genThread

local function isNoliGenerator(gen)
	if not gen then return false end
	local n = (gen.Name .. " " .. (gen:GetFullName() or "")):lower()
	if n:find("noli") then return true end
	if gen:GetAttribute("Noli") or gen:GetAttribute("IsNoli") then return true end
	for _, d in ipairs(gen:GetDescendants()) do
		if d.Name:lower():find("noli") then return true end
	end
	return false
end

local function findGenerators(skipNoli)
	local found, seen = {}, {}
	local function add(child)
		if seen[child] then return end
		if child.Name ~= "Generator" and child.Name ~= "FakeGenerator" then return end
		if skipNoli and isNoliGenerator(child) then return end
		seen[child] = true
		table.insert(found, child)
	end
	local function scan(root)
		if not root then return end
		for _, child in ipairs(root:GetChildren()) do add(child) end
	end
	scan(Workspace:FindFirstChild("Map"))
	local ingame = Workspace:FindFirstChild("Ingame")
	if ingame then
		scan(ingame:FindFirstChild("Map"))
		scan(ingame)
	end
	if #found == 0 then
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d.Name == "Generator" or d.Name == "FakeGenerator" then add(d) end
		end
	end
	return found
end

local function repairNearby()
	local hrp = getRoot(LocalPlayer.Character)
	if not hrp then return end
	for _, gen in ipairs(findGenerators(true)) do
		local progress = gen:FindFirstChild("Progress")
		local main = gen:FindFirstChild("Main") or gen:FindFirstChild("Base") or gen.PrimaryPart
		if not main then
			for _, c in ipairs(gen:GetChildren()) do
				if c:IsA("BasePart") then main = c break end
			end
		end
		if main and progress and tonumber(progress.Value) and progress.Value < 100 then
			if (hrp.Position - main.Position).Magnitude < 14 then
				local remotes = gen:FindFirstChild("Remotes")
				local re = remotes and (remotes:FindFirstChild("RE") or remotes:FindFirstChildWhichIsA("RemoteEvent"))
				if re then pcall(function() re:FireServer() end) end
				for _, r in ipairs(gen:GetDescendants()) do
					if r:IsA("RemoteEvent") and (r.Name == "RE" or r.Name:lower():find("repair") or r.Name:lower():find("gen")) then
						pcall(function() r:FireServer() end)
					end
				end
			end
		end
	end
end

local function setAutoGen(on)
	S.AutoGen = on
	genFlag = false
	if genThread then task.cancel(genThread) genThread = nil end
	if genConns then
		for _, c in ipairs(genConns) do pcall(function() c:Disconnect() end) end
		genConns = nil
	end
	if not on then return end

	local function loop()
		while genFlag do
			local t0 = os.clock()
			while genFlag and os.clock() - t0 < S.GenCD do RunService.Heartbeat:Wait() end
			if not genFlag then break end
			pcall(repairNearby)
		end
	end

	local function start()
		if genFlag then return end
		genFlag = true
		genThread = task.spawn(loop)
	end
	local function stop()
		genFlag = false
		if genThread then task.cancel(genThread) genThread = nil end
	end

	local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 8)
	genConns = {}
	if pg then
		table.insert(genConns, pg.ChildAdded:Connect(function(c)
			if c.Name == "PuzzleUI" or c.Name:lower():find("puzzle") or c.Name:lower():find("generator") then start() end
		end))
		table.insert(genConns, pg.ChildRemoved:Connect(function(c)
			if c.Name == "PuzzleUI" or c.Name:lower():find("puzzle") then stop() end
		end))
		for _, c in ipairs(pg:GetChildren()) do
			if c.Name == "PuzzleUI" or c.Name:lower():find("puzzle") then start() end
		end
	end
	start()
end

-- HUNTERAIM PATCH
local function patchHunterAim(src)
	-- Replace the broken drag/lock block with the working UserInputService version
	local brokenPattern = "local locked = false\nlocal dragStart, startPos\n\nlocal function beginDrag%(input%)[%s%S]-end%s*\nend%s*\nend"

	local fixedBlock = [[
local locked = false

lockBtn.MouseButton1Click:Connect(function()
    locked = not locked
    lockBtn.Text = locked and "🔒" or "🔓"
    lockBtn.BackgroundColor3 = locked and Color3.fromRGB(200, 60, 60) or Color3.fromRGB(80, 80, 100)
end)

local dragging = false
local dragStart = nil
local startPos = nil

local function beginDrag(input)
    if locked then return end
    dragging = true
    dragStart = input.Position
    startPos = panel.Position
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        beginDrag(input)
    end
end)

panel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        local hit = PlayerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
        for _, obj in ipairs(hit) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                return
            end
        end
        beginDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragStart = nil
    end
end)]]

	local patched, count = src:gsub(brokenPattern, fixedBlock, 1)
	if count > 0 then
		print("[Huntsaken] HunterAim drag patch applied")
		return patched
	end

	-- Fallback: locate the block by anchors and slice it out
	local startIdx = src:find("local locked = false", 1, true)
	if not startIdx then
		warn("[Huntsaken] HunterAim patch: start anchor missing")
		return src
	end

	local lockBtnIdx = src:find("lockBtn.MouseButton1Click", startIdx, true)
	if not lockBtnIdx then
		warn("[Huntsaken] HunterAim patch: lockBtn anchor missing")
		return src
	end

	-- Find end of the original broken block (the "lockBtn.MouseButton1Click" chain end)
	local endIdx = src:find("end%)%s*\n", lockBtnIdx)
	if not endIdx then
		warn("[Huntsaken] HunterAim patch: end anchor missing")
		return src
	end
	endIdx = endIdx + #"end)\n" - 1

	local before = src:sub(1, startIdx - 1)
	local after = src:sub(endIdx + 1)
	local rebuilt = before .. fixedBlock .. after
	print("[Huntsaken] HunterAim drag patch applied (fallback)")
	return rebuilt
end

